---
// Globe.astro - Low-fidelity spinning wireframe globe using Three.js with strict performance constraints
---

<div class="relative w-full h-full min-h-[300px] md:min-h-[400px] flex items-center justify-center overflow-hidden">
  <canvas id="globe-canvas" class="w-full h-full block absolute inset-0 outline-none"></canvas>
</div>

<script>
  // Dynamic lazy import of Three.js to not block initial render or page load
  async function initGlobe() {
    const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Check if scheduler.yield is available
    const hasYield = 'scheduler' in window && typeof (window as any).scheduler.yield === 'function';

    if (hasYield) {
      await (window as any).scheduler.yield();
    }

    // Lazy load Three.js
    const THREE = await import('three');

    if (hasYield) {
      await (window as any).scheduler.yield();
    }

    const container = canvas.parentElement;
    if (!container) return;

    // Get width and height
    let width = container.clientWidth || 400;
    let height = container.clientHeight || 400;

    // Scene creation
    const scene = new THREE.Scene();

    // Camera creation
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.z = 3;

    // Renderer creation with antialiasing and transparent background
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance"
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    if (hasYield) {
      await (window as any).scheduler.yield();
    }

    // Geometry - Icosahedron for a low-poly stylized look
    const geometry = new THREE.IcosahedronGeometry(1.2, 2);

    if (hasYield) {
      await (window as any).scheduler.yield();
    }

    // Fuchsia wireframe style
    const material = new THREE.MeshBasicMaterial({
      color: 0xc026d3, // Fuchsia
      wireframe: true,
      transparent: true,
      opacity: 0.85
    });

    const globe = new THREE.Mesh(geometry, material);
    scene.add(globe);

    // Inner glowing solid low-poly (very slightly visible)
    const innerMaterial = new THREE.MeshBasicMaterial({
      color: 0x171717,
      transparent: true,
      opacity: 0.3,
      wireframe: false
    });
    const innerGlobe = new THREE.Mesh(geometry, innerMaterial);
    innerGlobe.scale.setScalar(0.99);
    scene.add(innerGlobe);

    // Resize handler
    const resizeObserver = new ResizeObserver((entries) => {
      for (let entry of entries) {
        const { width: w, height: h } = entry.contentRect;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    });
    resizeObserver.observe(container);

    // Animation Loop
    let animationFrameId: number;
    let clock = new THREE.Clock();

    function animate() {
      animationFrameId = requestAnimationFrame(animate);

      const elapsedTime = clock.getElapsedTime();

      // Rotate the globe continuously
      globe.rotation.y = elapsedTime * 0.15;
      globe.rotation.x = elapsedTime * 0.08;

      innerGlobe.rotation.y = elapsedTime * 0.15;
      innerGlobe.rotation.x = elapsedTime * 0.08;

      renderer.render(scene, camera);
    }

    animate();

    // Clean up on component destruction / page transition if needed
    window.addEventListener('beforeunload', () => {
      cancelAnimationFrame(animationFrameId);
      resizeObserver.disconnect();
      geometry.dispose();
      material.dispose();
      innerMaterial.dispose();
      renderer.dispose();
    }, { once: true });
  }

  // Defer initialization to requestIdleCallback or setTimeout for Safari
  const loadWhenIdle = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => {
        initGlobe();
      }, { timeout: 2000 });
    } else {
      setTimeout(initGlobe, 200);
    }
  };

  if (document.readyState === 'complete') {
    loadWhenIdle();
  } else {
    window.addEventListener('load', loadWhenIdle);
  }
</script>
